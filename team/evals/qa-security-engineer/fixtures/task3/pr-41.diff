+++ b/src/app/api/rpc/route.ts
@@ -0,0 +1,22 @@
+// POST /api/rpc: test a customer's own node from Settings. JSON: { rpcUrl, method, params }.
+
+import { NextResponse } from "next/server";
+
+export async function POST(req: Request) {
+  const body = await req.json().catch(() => undefined) as { rpcUrl?: string; method?: string; params?: unknown[] } | undefined;
+  if (!body?.rpcUrl || !body.method) return NextResponse.json({ error: "Send rpcUrl and method." }, { status: 400 });
+  console.log("rpc test", JSON.stringify(body), req.headers.get("x-forwarded-for"));
+  try {
+    const res = await fetch(body.rpcUrl, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ jsonrpc: "2.0", id: 1, method: body.method, params: body.params ?? [] }),
+      redirect: "follow",
+    });
+    const text = await res.text();
+    return new Response(text, { status: res.status, headers: { "content-type": res.headers.get("content-type") ?? "text/plain" } });
+  } catch (e) {
+    return NextResponse.json({ error: String(e) }, { status: 502 });
+  }
+}
