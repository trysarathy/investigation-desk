 const AMOUNT = /^-?\d+(\.\d+)?$/;
 
+// Characters a spreadsheet skips or folds before it reads a formula: zero-width space and BOM in front,
+// and full-width forms (＝ ＋ － ＠) that NFKC folds to = + - @.
+const INVISIBLE_LEAD = /^[\u200B\uFEFF]+/;
+
 /** A spreadsheet must never execute a cell: values starting with = + - @ or a control are quoted as text. */
 export function csvCell(v: string | number | boolean | undefined | null): string {
   let s = v === undefined || v === null ? "" : String(v);
-  if (/^[=+\-@\t\r]/.test(s)) s = `'${s}`;
-  return /[",\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
+  const probe = s.replace(INVISIBLE_LEAD, "").normalize("NFKC");
+  if (/^[=+\-@\t\r]/.test(probe)) s = `'${s}`;
+  // ';' is a separator in many locales, so a cell holding one is quoted too.
+  return /[",;\n\r]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s;
 }
 
 /** Exact amounts (signed too) as numbers; everything else through csvCell. */
diff --git a/tests/csv-cell-fullwidth.test.ts b/tests/csv-cell-fullwidth.test.ts
