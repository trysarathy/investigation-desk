 });
+
+describe("line endings", () => {
+  it("refuses a file with classic Mac (CR-only) line endings instead of reading it as one row", () => {
+    const p = parseCsv("a,b\r1,2\r3,4\r");
+    expect(p.fileErrors).toEqual(['Line 1 ends with a carriage return only (old Mac line endings). Save the file as "CSV UTF-8" and upload it again.']);
+    expect(p.records).toEqual([]);
+  });
+
+  it("names the first CR-only line when a file mixes LF and CR", () => {
+    expect(parseCsv("a,b\n1,2\n3,4\r5,6\n").fileErrors[0]).toMatch(/^Line 3 ends with a carriage return only/);
+  });
+
+  it("still reads CRLF files, and keeps a CR inside a quoted value as text", () => {
+    const crlf = parseCsv("a,b\r\n1,2\r\n");
+    expect(crlf.fileErrors).toEqual([]);
+    expect(crlf.records).toEqual([{ line: 2, cells: ["1", "2"] }]);
+    const quoted = parseCsv('a,b\n"x\ry",2\n');
+    expect(quoted.fileErrors).toEqual([]);
+    expect(quoted.records[0].cells).toEqual(["x\ry", "2"]);
+  });
+
+  it("an upload with CR-only line endings gets the same file error", () => {
+    const r = validateFileA(bytes(`${A_HEAD}\r${EVM},bsc,C-9,2024-01-01T00:00:00Z,\r`));
+    expect(r.fileErrors).toEqual(['Line 1 ends with a carriage return only (old Mac line endings). Save the file as "CSV UTF-8" and upload it again.']);
+    expect(r.rows).toEqual([]);
+  });
+});
