+++ b/tests/csv-cell-unicode.test.ts
@@ -0,0 +1,21 @@
+// Unicode hardening for csvCell (exports): formula characters are neutralised whatever their form.
+
+import { describe, expect, it } from "vitest";
+import { csvCell, csvValue } from "@/lib/csv/cell";
+
+describe("csvCell unicode hardening", () => {
+  it("neutralises a formula after normalisation", () => {
+    expect(csvCell("=1+1")).toBe("'=1+1");
+    expect(csvCell("@SUM(A1)")).toBe("'@SUM(A1)");
+  });
+
+  it("leaves ordinary text and references alone", () => {
+    expect(csvCell("INV-1042")).toBe("INV-1042");
+    expect(csvCell("Acme Pte Ltd")).toBe("Acme Pte Ltd");
+  });
+
+  it("keeps exact amounts as numbers", () => {
+    expect(csvValue("4950.00")).toBe("4950.00");
+    expect(csvValue("-12.5")).toBe("-12.5");
+  });
+});
