sfer — it never claims a bank credit."],["LI",{},"Only the allow-listed testnet token on chain 84532 is accepted."]]]],["P",{"class":"ui_hint__TlNjc"},["STRONG",{},"Limitation:"]," ","Synthetic testnet observations; no live chain lookup in this console."],["DIV",{"class":"ui_actions__6tOJw"},["A",{"class":"ui_btn__iF0Mu ui_primary__wzun4 ","href":"/clearline/payments/pi_s4_chain"},"Start case ","04",": ","Base Sepolia finality delay"],["BUTTON",{"type":"button","class":"ui_btn__iF0Mu  ui_small__1lEMT "},"Reset to starting state"]]]],["SECTION",{"class":"ui_panel__ufPk4","id":"case-05","aria-labelledby":"case-05-h"},["DIV",{"class":"ui_panelHead__9cROC"},["H2",{"id":"case-05-h"},"05"," / 05 · ","Funding exposure"],["DIV",{"class":"ui_actions__6tOJw"},["SPAN",{"class":"ui_hint__TlNjc"},"Control · Funding exposure"]]],["DIV",{"class":"ui_panelBody__c0Kjm"},["DIV",{"class":"ui_grid3__uu14E"},["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Starting state"],["P",{"style":"margin:0"},"The provider advanced SGD 50,000.00 to pay a supplier before its customer reimbursed it."]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"What you do"],["OL",{"style":"margin:0;padding-left:18px"},["LI",{},"Open Funding exposure."],["LI",{},"Check principal, repaid and outstanding, with the due date and repayment evidence."],["LI",{},"Follow the exception for the receipt that quoted no reference."]]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Expected system response"],["UL",{"style":"margin:0;padding-left:18px"},["LI",{},"SGD 50,000.00 advanced → SGD 30,000.00 repaid by reference → SGD 20,000.00 outstanding."],["LI",{},"An unreferenced SGD 20,000.00 receipt is an exception, not a close — even though the amount equals what is owed."],["LI",{},"The supplier payout links to its own investigation page."]]]],["P",{"class":"ui_hint__TlNjc"},["STRONG",{},"Limitation:"]," ","A projection, not a shared ledger. The provider makes every credit decision; Clearline lends nothing."],["DIV",{"class":"u