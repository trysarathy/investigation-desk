+// Every time on screen is Singapore time (SGT, UTC+8, no daylight saving), the pilot region.
+const SGT_OFFSET_MS = 8 * 3600_000;
+const DAY_MS = 86_400_000;
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+const pad2 = (n: number) => String(n).padStart(2, "0");
+
+/** The wall-clock fields of an instant in Singapore. */
+function sgt(ms: number) {
+  const d = new Date(ms + SGT_OFFSET_MS);
+  return { y: d.getUTCFullYear(), mo: d.getUTCMonth(), d: d.getUTCDate(), wd: d.getUTCDay(), hm: `${pad2(d.getUTCHours())}:${pad2(d.getUTCMinutes())}` };
+}
+
+/** "2026-10-31 15:30 SGT". */
 export function formatTime(iso: string): string {
-  // Display in Singapore time, the pilot region, with the offset written out.
-  const d = new Date(Date.parse(iso) + 8 * 3600_000);
-  const p = (n: number) => String(n).padStart(2, "0");
-  return `${d.getUTCFullYear()}-${p(d.getUTCMonth() + 1)}-${p(d.getUTCDate())} ${p(d.getUTCHours())}:${p(d.getUTCMinutes())} SGT`;
+  const t = sgt(Date.parse(iso));
+  return `${t.y}-${pad2(t.mo + 1)}-${pad2(t.d)} ${t.hm} SGT`;
+}
+
+/** "Today 09:05 SGT", "Yesterday 14:32 SGT", "Mon 11:20 SGT", or "3 Oct 11:20 SGT". */
+export function friendlyTime(iso: string, now = Date.now()): string {
+  const ms = Date.parse(iso);
+  const t = sgt(ms);
+  const daysAgo = Math.floor((now - ms) / DAY_MS);
+  const when = daysAgo === 0 ? "Today" : daysAgo === 1 ? "Yesterday" : daysAgo > 1 && daysAgo < 7 ? WEEKDAYS[t.wd] : `${t.d} ${MONTHS[t.mo]}`;
+  return `${when} ${t.hm} SGT`;
 }
 
