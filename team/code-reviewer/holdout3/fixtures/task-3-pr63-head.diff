+/** The calendar day in Singapore time (the pilot region), e.g. for a file name. */
+export function sgtDay(iso: string): string {
+  // The platform's date formatter instead of adding hours by hand; en-CA writes YYYY-MM-DD.
+  return new Date(iso).toLocaleDateString("en-CA");
