# Replace with the ID from the end of your Formspree URL (https://formspree.io/f/FORM_ID).
NEXT_PUBLIC_FORMSPREE_ID=FORM_ID
# Paste your actual scheduling page (https://...); leave unset until ready.
NEXT_PUBLIC_BOOKING_URL=
# Add a verified privacy email before accepting enquiries.
NEXT_PUBLIC_PRIVACY_EMAIL=
# Set after you connect a verified custom domain, e.g. https://clearline.example
NEXT_PUBLIC_SITE_URL=
