# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com
# Your Google Calendar booking page (15-min "Learning call")
NEXT_PUBLIC_MEETING_URL=
# The form ID from formspree.io (the part after /f/)
NEXT_PUBLIC_FORMSPREE_ID=
# An address on your domain, e.g. hello@your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=
