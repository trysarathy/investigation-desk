# Read-only chain API keys. Both are OPTIONAL: with neither set the app still runs live,
# using these free public endpoints (checked 24 Oct 2026):
#   Tron        https://api.trongrid.io                 (TronGrid, keyless at a lower rate limit)
#   Ethereum    https://eth.drpc.org                    (used when ETHERSCAN_API_KEY is empty)
#   Polygon     https://polygon.drpc.org                (used when ETHERSCAN_API_KEY is empty)
#   Arbitrum    https://arb1.arbitrum.io/rpc            (used when ETHERSCAN_API_KEY is empty)
#   Ethereum token history for D07b: https://eth.blockscout.com/api/v2 (keyless)
#   BNB Chain   https://bsc-dataseed.bnbchain.org
#   Base        https://mainnet.base.org
#   Optimism    https://mainnet.optimism.io
# Public endpoints see the hashes and addresses you look up. For a pilot, use keyed or paid providers.
# OFFLINE_REPLAY_DIR=tests/fixtures/real   # demo without internet: recorded real responses only
# Copy to .env (git-ignored) or set in the server environment. Never commit real values.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
# LIVE_LOOKUPS=off                 # turn live chain lookups off entirely

# Optional. Without a key, explanations use the approved template text.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5        # default; any current Claude model ID
# AI_EXPLANATIONS=off              # force template text

# Demo preview (README "Private preview"): seed the demo workspace and turn uploads off.
# DEMO_MODE=1
# PREVIEW_USER=
# PREVIEW_PASSWORD=

# Node 22 behind an HTTP proxy: let fetch() use HTTPS_PROXY.
# NODE_USE_ENV_PROXY=1
