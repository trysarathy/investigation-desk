+import { Reveal } from "./ui";
+
+// What a visitor can check for themselves, in place of logos or quotes we don't have.
+// Every line traces to company/PRODUCT_FACTS.md or the 52-of-52 test already in the Trust section.
+const proof = [
+  { k: "52 of 52", v: "real public USDC and USDT transfers checked correctly in our own test.", note: "Our own small test, not a customer result." },
+  { k: "Tron, Ethereum, BNB Chain", v: "USDT and USDC payments checked on all three today.", note: "Payment pages: Ethereum for now." },
+  { k: "Read-only", v: "Clearline reads the blockchain. It never holds keys or moves money.", note: null },
+  { k: "You approve", v: "Nothing reaches your books until a person clicks Approve.", note: "Xero first (in testing), QuickBooks next." },
+];
+
+export function Proof() {
+  return (
+    <section aria-labelledby="proof-h" className="mx-auto max-w-6xl px-5 pt-16 sm:px-8 sm:pt-20">
+      <h2 id="proof-h" className="sr-only">What you can check today</h2>
+      <Reveal>
+        <ul className="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
