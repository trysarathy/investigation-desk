+++ b/tests/security-demo-reset.test.ts
@@ -0,0 +1,56 @@
+// SECURITY_GAPS #1 and #4(a): the demo-only routes worked on a live deployment. One POST to
+// /api/demo/reset wiped the live workspace, cases and bulk runs; /api/requests/demo seeded fictional
+// records into the live payment-requests store. Written failing first (it.fails on
+// security/demo-reset-guard and security/demo-guards-live); switched to it with the fix.
+
+import { mkdir, mkdtemp, readFile, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+
+const saved = { dir: process.env.DESK_DATA_DIR, mode: process.env.DEMO_MODE };
+let dir: string;
+beforeEach(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), "desk-reset-"));
+  process.env.DESK_DATA_DIR = dir;
+  await writeFile(path.join(dir, "cases.json"), JSON.stringify({ cases: [{ id: "CASE-1" }] }));
+  await mkdir(path.join(dir, "bulk"));
+  await writeFile(path.join(dir, "bulk", "run-1.json"), "{}");
+});
+afterEach(() => {
+  if (saved.dir === undefined) delete process.env.DESK_DATA_DIR; else process.env.DESK_DATA_DIR = saved.dir;
+  if (saved.mode === undefined) delete process.env.DEMO_MODE; else process.env.DEMO_MODE = saved.mode;
+});
+
+const exists = (p: string) => stat(p).then(() => true, () => false);
+const post = (url: string, body?: unknown) => new Request(url, { method: "POST", headers: { "content-type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) });
+
+describe("demo-only routes in live mode", () => {
+  it("POST /api/demo/reset is refused in live mode and leaves the live workspace, cases and bulk runs alone", async () => {
+    process.env.DEMO_MODE = "off";
+    const { POST } = await import("@/app/api/demo/reset/route");
+    const res = await POST();
+    expect(res.status).toBe(403);
+    expect(await exists(path.join(dir, "cases.json")), "cases.json deleted").toBe(true);
+    expect(await exists(path.join(dir, "bulk", "run-1.json")), "bulk runs deleted").toBe(true);
+    expect(await exists(path.join(dir, "workspace.json")), "workspace replaced").toBe(false);
+  });
+
+  it("POST /api/requests/demo is refused in live mode and writes no demo records", async () => {
+    process.env.DEMO_MODE = "off";
+    const { POST } = await import("@/app/api/requests/demo/route");
+    const res = await POST(post("http://desk.test/api/requests/demo", { kind: "reset" }));
+    expect(res.status).toBe(403);
+    const text = await readFile(path.join(dir, "requests.json"), "utf8").catch(() => "");
+    expect(text, "demo requests written into the live store").not.toMatch(/DEMO-/);
+  });
+
+  it("in demo mode both routes still work", async () => {
+    delete process.env.DEMO_MODE;
+    const { POST: reset } = await import("@/app/api/demo/reset/route");
+    expect((await reset()).status).toBe(200);
+    expect(await exists(path.join(dir, "cases.json"))).toBe(false);
+    const { POST: day } = await import("@/app/api/requests/demo/route");
+    expect((await day(post("http://desk.test/api/requests/demo", { kind: "reset" }))).status).toBe(200);
+  });
+});
