diff --git a/tests/demo-reset-guard.test.ts b/tests/demo-reset-guard.test.ts
new file mode 100644
index 0000000..b7c2c25
--- /dev/null
+++ b/tests/demo-reset-guard.test.ts
@@ -0,0 +1,54 @@
+// Security gap #1 (team/SECURITY_GAPS.md): POST /api/demo/reset must never wipe a live workspace.
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { existsSync } from "node:fs";
+import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { POST } from "@/app/api/demo/reset/route";
+
+const saved = { DESK_DATA_DIR: process.env.DESK_DATA_DIR, DEMO_MODE: process.env.DEMO_MODE };
+let dir = "";
+
+beforeEach(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), "desk-reset-"));
+  process.env.DESK_DATA_DIR = dir;
+  await writeFile(path.join(dir, "cases.json"), JSON.stringify({ cases: [{ id: "CS-1" }] }));
+  await mkdir(path.join(dir, "bulk"));
+  await writeFile(path.join(dir, "bulk", "run-1.json"), "{}");
+});
+
+afterEach(async () => {
+  for (const [k, v] of Object.entries(saved)) {
+    if (v === undefined) delete process.env[k];
+    else process.env[k] = v;
+  }
+  await rm(dir, { recursive: true, force: true });
+});
+
+describe("POST /api/demo/reset", () => {
+  it("is refused in live mode and leaves the live workspace, cases and bulk runs alone", async () => {
+    process.env.DEMO_MODE = "off";
+    const res = await POST();
+    expect(res.status).toBe(403);
+    expect((await res.json()).error).toMatch(/live mode/);
+    expect(existsSync(path.join(dir, "cases.json"))).toBe(true);
+    expect(existsSync(path.join(dir, "bulk", "run-1.json"))).toBe(true);
+    expect(existsSync(path.join(dir, "workspace.json"))).toBe(false);
+  });
+
+  it.each(["0", "false", "no", "live", " OFF "])("DEMO_MODE=%j is live mode too, and is refused", async (v) => {
+    process.env.DEMO_MODE = v;
+    expect((await POST()).status).toBe(403);
+    expect(existsSync(path.join(dir, "cases.json"))).toBe(true);
+  });
+
+  it("still resets in demo mode: sample files loaded, demo cases and bulk runs cleared", async () => {
+    process.env.DEMO_MODE = "on";
+    const res = await POST();
+    expect(res.status).toBe(200);
+    expect(existsSync(path.join(dir, "workspace.json"))).toBe(true);
+    expect(existsSync(path.join(dir, "cases.json"))).toBe(false);
+    expect(existsSync(path.join(dir, "bulk"))).toBe(false);
+  });
+});
