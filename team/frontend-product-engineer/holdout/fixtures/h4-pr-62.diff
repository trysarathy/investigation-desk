-export function ApprovePosting({ requestId, planKey, label }: { requestId: string; planKey: string; label: string }) {
+type Line = { account: string; description: string; amount: string; currency: string };
+
+export function ApprovePosting({ requestId, planKey, label, lines }: { requestId: string; planKey: string; label: string; lines: Line[] }) {
