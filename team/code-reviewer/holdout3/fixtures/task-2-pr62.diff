+describe("rounding tolerance", () => {
+  it("a shortfall of a fraction of a cent is rounding: the request is matched, not short", () => {
+    let d = real(emptyRequests(), "R1", "250.00", addr("r1"));
+    d = put(d, tx(addr("r1"), "249.995", "a"));
+    expect(view(d, "R1").state).toBe("matched");
+    expect(view(d, "R1").review).toBeUndefined();
+    expect(view(d, "R1").reasons[0]).toMatch(/within the 0.01 rounding tolerance/);
+  });
+
+  it("a shortfall of more than a cent is still short and needs a person", () => {
+    let d = real(emptyRequests(), "R1", "250.00", addr("r1"));
+    d = put(d, tx(addr("r1"), "249.98", "a"));
+    expect(view(d, "R1").state).toBe("needs_review");
+    expect(view(d, "R1").review).toBe("short");
+  });
+});
