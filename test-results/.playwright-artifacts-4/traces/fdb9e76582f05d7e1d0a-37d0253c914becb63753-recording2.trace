e-01-h"},"01"," / 05 · ","Successful payment"],["DIV",{"class":"ui_actions__6tOJw"},["SPAN",{"class":"ui_hint__TlNjc"},"Workspace · Investigation"]]],["DIV",{"class":"ui_panelBody__c0Kjm"},["DIV",{"class":"ui_grid3__uu14E"},["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Starting state"],["P",{"style":"margin:0"},"A supplier payout the sandbox provider reports as completed, plus a separate bank statement line."]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"What you do"],["OL",{"style":"margin:0;padding-left:18px"},["LI",{},"Open the payment."],["LI",{},"Read the three status dimensions in the header."],["LI",{},"In the evidence timeline, find the provider event and the statement line, each with its source."]]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Expected system response"],["UL",{"style":"margin:0;padding-left:18px"},["LI",{},"Execution says the provider reports completion — not “payment successful”."],["LI",{},"Settlement evidence comes from the bank statement line, matched by trusted reference with code RC_EXACT_REFERENCE_AMOUNT_CURRENCY_WINDOW."],["LI",{},"Reconciliation is shown separately as matched."]]]],["P",{"class":"ui_hint__TlNjc"},["STRONG",{},"Limitation:"]," ","The statement line is fictional; no bank is connected."],["DIV",{"class":"ui_actions__6tOJw"},["A",{"class":"ui_btn__iF0Mu ui_primary__wzun4 ","href":"/clearline/payments/pi_s1_success"},"Start case ","01",": ","Successful payment"],["BUTTON",{"type":"button","class":"ui_btn__iF0Mu  ui_small__1lEMT "},"Reset to starting state"]]]],["SECTION",{"class":"ui_panel__ufPk4","id":"case-02","aria-labelledby":"case-02-h"},["DIV",{"class":"ui_panelHead__9cROC"},["H2",{"id":"case-02-h"},"02"," / 05 · ","Returned payout"],["DIV",{"class":"ui_actions__6tOJw"},["SPAN",{"class":"ui_hint__TlNjc"},"Investigation · Exceptions"]]],["DIV",{"class":"ui_panelBody__c0Kjm"},["DIV",{"class":"ui_grid3__uu14E"},["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Starting state"],["P",{"style":"margin:0"},"The beneficiary's bank rejected the payout; the provider reported a return and a return line arrived on the statement."]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"What you do"],["OL",{"style":"margin:0;padding-left:18px"},["LI",{},"Open the payment and read the explanation panel."],["LI",{},"In the case section, assign an owner and add a note."],["LI",{},"Try to resolve the case or its exception."]]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Expected system response"],["UL",{"style":"margin:0;padding-left:18px"},["LI",{},"The explanation names what is known, what is not yet known, and what is still financially outstanding."],["LI",{},"Resolve is refused until the engine's conditions are met, and the reason is shown."],["LI",{},"Every action appears in the case history and the audit log."]]]],["P",{"class":"ui_hint__TlNjc"},["STRONG",{},"Limitation:"]," ","Beneficiary details are opaque test references; no real account is checked."],["DIV",{"class":"ui_actions__6tOJw"},["A",{"class":"ui_btn__iF0Mu ui_primary__wzun4 ","href":"/clearline/payments/pi_s2_returned"},"Start case ","02",": ","Returned payout"],["BUTTON",{"type":"button","class":"ui_btn__iF0Mu  ui_small__1lEMT "},"Reset to starting state"]]]],["SECTION",{"class":"ui_panel__ufPk4","id":"case-03","aria-labelledby":"case-03-h"},["DIV",{"class":"ui_panelHead__9cROC"},["H2",{"id":"case-03-h"},"03"," / 05 · ","Compliance hold"],["DIV",{"class":"ui_actions__6tOJw"},["SPAN",{"class":"ui_hint__TlNjc"},"Control · Compliance holds"]]],["DIV",{"class":"ui_panelBody__c0Kjm"},["DIV",{"class":"ui_grid3__uu14E"},["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"Starting state"],["P",{"style":"margin:0"},"The partner placed the payout on hold and asked for supporting documents."]],["DIV",{},["H3",{"class":"ui_eyebrow__ormGU"},"What you do"],["OL",{"style":"margin:0;padding-left:18px"},["LI",{},"Submit the requested document names (metadata only)."],["LI",{},"Assign the compliance reviewer."],["LI",{},"Switch “Acting as” to Pri