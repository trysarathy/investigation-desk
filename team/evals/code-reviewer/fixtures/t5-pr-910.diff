diff --git a/tests/xero-refresh.test.ts b/tests/xero-refresh.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/xero-refresh.test.ts
@@ -0,0 +1,44 @@
+// Token refresh margin: a token with 4 minutes left is refreshed before use; one with 10 minutes left isn't.
+// The token response is a real one captured from the Demo Company connection on 31 Oct (expired since).
+
+import { mkdtemp, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { beforeEach, describe, expect, it } from "vitest";
+import tokenResponse from "./fixtures/xero-token-response.json";
+import { accessToken, REFRESH_MARGIN_MS } from "@/lib/accounting/providers/xero-auth";
+
+process.env.XERO_CLIENT_ID = "6A1B6F0E5C2D4B7A9E3F8C1D2B4A6E8F";
+process.env.XERO_CLIENT_SECRET = "KEECJUWD4SRaqzYlLNLzDd7ERB2WDvH17oq-s4vgRlJon_ZW";
+
+const NOW = Date.parse("2026-10-31T15:00:00.000Z");
+let dir: string;
+beforeEach(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), "desk-xero-refresh-"));
+  process.env.DESK_DATA_DIR = dir;
+});
+
+async function saveTokens(expiresInMs: number) {
+  await writeFile(path.join(dir, "xero-tokens.json"), JSON.stringify({
+    accessToken: "old-access", refreshToken: "old-refresh", expiresAt: NOW + expiresInMs, tenantId: "t-1", tenantName: "Demo Company (Global)",
+  }));
+}
+
+describe("Xero access token refresh margin", () => {
+  it("refreshes a token with 4 minutes left", async () => {
+    await saveTokens(4 * 60_000);
+    const calls: string[] = [];
+    const fetchFn = async (url: string) => { calls.push(url); return { ok: true, status: 200, json: async () => tokenResponse, text: async () => "" }; };
+    const t = await accessToken(fetchFn as never, NOW);
+    expect(calls).toEqual(["https://identity.xero.com/connect/token"]);
+    expect(t.token).toBe(tokenResponse.access_token);
+  });
+
+  it("keeps a token with 10 minutes left", async () => {
+    await saveTokens(10 * 60_000);
+    const fetchFn = async () => { throw new Error("should not refresh"); };
+    expect((await accessToken(fetchFn as never, NOW)).token).toBe("old-access");
+    expect(REFRESH_MARGIN_MS).toBe(300_000);
+  });
+});

