diff --git a/tests/security-pay-check-gate.test.ts b/tests/security-pay-check-gate.test.ts
new file mode 100644
index 0000000..0fdfbd9
--- /dev/null
+++ b/tests/security-pay-check-gate.test.ts
@@ -0,0 +1,43 @@
+// SECURITY_GAPS #3: the preview password gate let /pay/<id> through but not the payer's address
+// check that page posts to, so the look-alike (poisoning) warning silently failed with 401.
+// Written failing first (it.fails on security/pay-check-preview-gate); switched to it with the fix.
+
+import { NextRequest } from "next/server";
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import { middleware } from "@/middleware";
+
+const saved = { u: process.env.PREVIEW_USER, p: process.env.PREVIEW_PASSWORD };
+beforeAll(() => { process.env.PREVIEW_USER = "u"; process.env.PREVIEW_PASSWORD = "p"; });
+afterAll(() => {
+  if (saved.u === undefined) delete process.env.PREVIEW_USER; else process.env.PREVIEW_USER = saved.u;
+  if (saved.p === undefined) delete process.env.PREVIEW_PASSWORD; else process.env.PREVIEW_PASSWORD = saved.p;
+});
+
+const call = (path: string, method = "GET", auth = false) =>
+  middleware(new NextRequest(`http://desk.test${path}`, { method, headers: auth ? { authorization: `Basic ${btoa("u:p")}` } : {} }));
+
+describe("preview gate and the payer's address check", () => {
+  it("POST /api/pay/<publicId>/check is reachable without the preview password, like /pay/<publicId>", () => {
+    expect(call("/pay/Ab3_x-9QzLkP").status).not.toBe(401);
+    expect(call("/api/pay/Ab3_x-9QzLkP/check", "POST").status).not.toBe(401);
+  });
+
+  it("everything else under /api still needs the preview password", () => {
+    for (const [path, method] of [
+      ["/api/pay/Ab3_x-9QzLkP/check", "GET"],
+      ["/api/pay/Ab3_x-9QzLkP/check/extra", "POST"],
+      ["/api/pay/Ab3_x-9QzLkP", "POST"],
+      ["/api/pay/a/b/check", "POST"],
+      ["/api/payx/Ab3_x-9QzLkP/check", "POST"],
+      ["/api/accounting/DEMO-1042", "POST"],
+      ["/api/demo/reset", "POST"],
+      ["/api/requests", "GET"],
+    ] as const) {
+      expect(call(path, method).status, `${method} ${path}`).toBe(401);
+    }
+  });
+
+  it("the right password still gets in everywhere", () => {
+    expect(call("/api/accounting/DEMO-1042", "POST", true).status).not.toBe(401);
+  });
+});
