diff --git a/src/components/books/PostedNotice.tsx b/src/components/books/PostedNotice.tsx
new file mode 100644
index 0000000..d748e1e
--- /dev/null
+++ b/src/components/books/PostedNotice.tsx
@@ -0,0 +1,27 @@
+"use client";
+
+// The lasting confirmation after a posting: stays in the panel (no timer), announced politely, and
+// takes focus only when it replaces the Approve button the person just pressed.
+
+import Link from "next/link";
+import { useEffect, useRef } from "react";
+
+export const JUST_POSTED = "clearline.justPosted";
+
+export function PostedNotice({ requestId, where, lines, by, when }: { requestId: string; where: string; lines: number; by: string; when: string }) {
+  const ref = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    try {
+      if (sessionStorage.getItem(JUST_POSTED) === requestId) { sessionStorage.removeItem(JUST_POSTED); ref.current?.focus(); }
+    } catch { /* storage blocked: no focus move, the notice is still there */ }
+  }, [requestId]);
+  return (
+    <div ref={ref} tabIndex={-1} role="status" className="bar bar-paid posted-notice" data-testid="posted-notice">
+      <span aria-hidden="true" className="posted-tick">✓</span>
+      <span className="posted-text">
+        <strong>Posted to {where}</strong> · {lines} {lines === 1 ? "line" : "lines"} · approved by {by}, {when}
+      </span>
+      <Link href="/books" className="posted-link">Audit log</Link>
+    </div>
+  );
+}
