+/** Wallets and exchanges sometimes round away the last fraction of a cent. A shortfall up to this is rounding, not a short payment. */
+export const ROUNDING_TOLERANCE = 0.01;
+const withinRounding = (requested: string, received: string) => parseFloat(requested) - parseFloat(received) <= ROUNDING_TOLERANCE;
+
 export function deriveRequest(data: RequestsData, r: PaymentRequest, threshold: number): RequestView {
   const mine = Object.values(data.observations).filter((o) => o.attribution.kind === "request" && o.attribution.requestId === r.id)
     .sort((a, b) => (a.firstSeenAt < b.firstSeenAt ? -1 : 1));
