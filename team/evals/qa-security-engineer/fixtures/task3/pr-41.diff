+// GET /api/requests/export.csv: every payment request, for finance.
+
+import { loadRequests } from "@/lib/requests/service";
+
+export const dynamic = "force-dynamic";
+
+export async function GET() {
+  const { views } = await loadRequests();
+  const header = "id,customer,invoice,amount,token,state,receiving_address";
+  const rows = views.map((v) => [v.request.id, v.request.customerRef, v.request.invoiceRef, v.request.amount, v.request.token, v.state, v.request.receivingAddress].join(","));
+  return new Response([header, ...rows].join("\n"), {
+    headers: { "content-type": "text/csv; charset=utf-8", "content-disposition": 'attachment; filename="requests.csv"' },
+  });
+}
