diff --git a/tests/format.test.ts b/tests/format.test.ts
new file mode 100644
index 0000000..28bcf03
--- /dev/null
+++ b/tests/format.test.ts
@@ -0,0 +1,26 @@
+// The SGT display helpers, now in one place (lib/format). These pin today's output so the move
+// changes nothing on screen.
+
+import { describe, expect, it } from "vitest";
+import { formatTime, friendlyTime } from "@/lib/format";
+import { friendlyTime as fromRequests } from "@/lib/requests/ui";
+
+const NOW = Date.parse("2026-10-31T07:00:00Z"); // Sat 31 Oct, 15:00 SGT
+
+describe("SGT display helpers", () => {
+  it("formatTime writes the Singapore date and time", () => {
+    expect(formatTime("2026-10-31T07:30:00Z")).toBe("2026-10-31 15:30 SGT");
+    expect(formatTime("2026-12-31T16:05:00.000Z")).toBe("2027-01-01 00:05 SGT"); // past midnight in Singapore
+  });
+
+  it("friendlyTime says today, yesterday, the weekday, or the date", () => {
+    expect(friendlyTime("2026-10-31T01:05:00Z", NOW)).toBe("Today 09:05 SGT");
+    expect(friendlyTime("2026-10-30T06:32:00Z", NOW)).toBe("Yesterday 14:32 SGT");
+    expect(friendlyTime("2026-10-26T03:20:00Z", NOW)).toBe("Mon 11:20 SGT");
+    expect(friendlyTime("2026-10-03T03:20:00Z", NOW)).toBe("3 Oct 11:20 SGT");
+  });
+
+  it("the request pages still get the same function", () => {
+    expect(fromRequests).toBe(friendlyTime);
+  });
+});
