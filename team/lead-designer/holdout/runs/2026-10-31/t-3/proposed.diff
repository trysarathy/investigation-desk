+            <li key={p.k} className="bg-ink p-6">
+              <p className="text-[18px] font-semibold tracking-tight text-fg">{p.k}</p>
+              <p className="mt-2 text-[15px] leading-relaxed text-muted">{p.v}</p>
+              {p.note && <p className="mt-3 text-[12.5px] text-faint">{p.note}</p>}
+            </li>
+          ))}
