{
  "name": "investigation-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:control": "vitest run --config vitest.control.config.ts",
    "e2e:control": "playwright test -c playwright.control.config.ts",
    "db:migrate": "drizzle-kit migrate",
    "control:admin": "tsx --conditions=react-server scripts/control/admin.ts",
    "typecheck": "tsc --noEmit",
    "reconstruct": "tsx scripts/reconstruct/reconstruct.ts",
    "lint": "npm install --no-save --no-audit --no-fund eslint@9.39.5 eslint-config-next@15.5.28 @eslint/eslintrc@3.3.7 && eslint -c .github/lint/eslint.config.mjs .",
    "owed-ledger": "sh scripts/owed-ledger.sh",
    "funding-export": "sh scripts/funding-export.sh",
    "funding-evidence": "sh scripts/funding-evidence.sh",
    "funding-setup": "sh scripts/funding-setup.sh",
    "funding-start": "CLEARLINE_FUNDING_ONLY=1 next start",
    "funding-dev": "CLEARLINE_FUNDING_ONLY=1 next dev",
    "funding-audit": "sh scripts/funding-audit.sh",
    "funding-replay-kit": "sh scripts/funding-replay-kit.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@noble/hashes": "1.8.0",
    "@types/qrcode": "1.5.5",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.12.1",
    "next": "15.5.29",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "axe-core": "4.14.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
