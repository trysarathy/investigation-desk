 const SCENARIOS = new Set(["a"]);
 
 export async function POST(req: Request) {
+  // Live mode: the simulated provider must never write demo records into the live store (SECURITY_GAPS #4a).
+  if (process.env.DEMO_MODE === "off") return NextResponse.json({ error: "The demo controls are off on this server." }, { status: 403 });
