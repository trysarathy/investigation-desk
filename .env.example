# Read-only chain API keys. Copy to .env (git-ignored) or set in the server environment.
# Never commit real values.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# Optional. Without a key, explanations use the approved template text.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5        # default; any current Claude model ID
# AI_EXPLANATIONS=off              # force template text

# Demo preview (README "Private preview"): seed the demo workspace and turn uploads off.
# DEMO_MODE=1
# PREVIEW_USER=
# PREVIEW_PASSWORD=

# Single-company deployment. Production refuses requests without auth unless DEMO_MODE=1.
# Node >=22.13 required for node:sqlite.
# WORKSPACE_ID=company-slug
# SESSION_SECRET=at-least-32-random-characters
# DESK_USERS=[{"id":"analyst-1","role":"analyst","salt":"...","passwordHash":"scrypt-64-byte-hex","totpSecret":"BASE32"}]
# PUBLIC_APP_URL=https://your-desk.example
# RPC_ETHEREUM_URL=https://operator-configured-read-only-rpc
# RPC_BSC_URL=
# RPC_POLYGON_URL=
# RPC_BASE_URL=
# RPC_ARBITRUM_URL=
# RPC_OPTIMISM_URL=
# SLACK_SIGNING_SECRET=
# SLACK_TEAM_ID=
# TICKET_API_TOKEN=
# NODE_USE_ENV_PROXY=1  # only if your deployment requires an HTTP(S) proxy
# SLACK_BOT_TOKEN=
# SLACK_ALERT_CHANNEL=
# SLACK_ALERTS_ENABLED=1  # enables admin-triggered delivery; off unless explicitly set
