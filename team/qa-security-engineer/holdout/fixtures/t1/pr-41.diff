@@ -0,0 +1,27 @@
+// The preview password gate: everything asks for it, except the sender's payment page and its checker.
+
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { NextRequest } from "next/server";
+import { middleware } from "@/middleware";
+
+const at = (path: string, auth?: string) =>
+  middleware(new NextRequest(new URL(path, "http://desk.test"), { method: "POST", headers: auth ? { authorization: auth } : {} }));
+
+describe("preview password", () => {
+  beforeEach(() => { process.env.PREVIEW_USER = "demo"; process.env.PREVIEW_PASSWORD = "FICTIONAL-preview-pw"; });
+  afterEach(() => { delete process.env.PREVIEW_USER; delete process.env.PREVIEW_PASSWORD; });
+
+  it("asks for it on the app", () => {
+    expect(at("/requests").status).toBe(401);
+    expect(at("/api/requests").status).toBe(401);
+  });
+
+  it("lets the sender's page and its address checker through", () => {
+    expect(at("/pay/AbCdEfGhIjKl").status).toBe(200);
+    expect(at("/api/pay/AbCdEfGhIjKl/check").status).toBe(200);
+  });
+
+  it("accepts the right password", () => {
+    expect(at("/requests", `Basic ${btoa("demo:FICTIONAL-preview-pw")}`).status).toBe(200);
+  });
+});
