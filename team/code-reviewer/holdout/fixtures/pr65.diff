index 0000000..e0d6a7e
--- /dev/null
+++ b/tests/csv-cell-fullwidth.test.ts
@@ -0,0 +1,30 @@
+// Security gap #7 (team/SECURITY_GAPS.md): full-width signs, a zero-width space or BOM before '=',
+// and ';' must not let a spreadsheet run a cell from an export.
+
+import { describe, expect, it } from "vitest";
+import { csvCell } from "@/lib/csv/cell";
+
+describe("csv cell: look-alike formula starts are neutralised", () => {
+  it("full-width equals ＝ is neutralised", () => {
+    expect(csvCell("＝1+1")).not.toBe("=1+1");
+  });
+  it("full-width plus ＋ and minus － are neutralised", () => {
+    expect(csvCell("＋1")).not.toBe("+1");
+    expect(csvCell("－1")).not.toBe("-1");
+  });
+  it("full-width at ＠ is neutralised", () => {
+    expect(csvCell("＠SUM(A1)")).not.toBe("@SUM(A1)");
+  });
+  it("a zero-width space before = is neutralised", () => {
+    expect(csvCell("​=1+1")).not.toMatch(/^=/);
+  });
+  it("a BOM before = is neutralised", () => {
+    expect(csvCell("﻿=1+1")).not.toMatch(/^=/);
+  });
+  it("a cell containing ';' is quoted", () => {
+    expect(csvCell("ref;=1+1")).toContain("=1+1");
+  });
+  it("ordinary text is unchanged", () => {
+    expect(csvCell("INV-1042")).toBe("INV-1042");
+  });
+});
