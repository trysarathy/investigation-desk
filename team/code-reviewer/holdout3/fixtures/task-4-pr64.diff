diff --git a/tests/preview-gate.test.ts b/tests/preview-gate.test.ts
new file mode 100644
index 0000000..6b65818
--- /dev/null
+++ b/tests/preview-gate.test.ts
@@ -0,0 +1,24 @@
+// The preview password gate (src/middleware.ts): the payer's page and its address check are open,
+// everything else asks for the password.
+
+import { NextRequest } from "next/server";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { middleware } from "@/middleware";
+
+const req = (path: string, method = "GET") => new NextRequest(new URL(path, "http://localhost:3000"), { method });
+
+describe("preview password gate", () => {
+  beforeEach(() => { process.env.PREVIEW_USER = "u"; process.env.PREVIEW_PASSWORD = "p"; });
+  afterEach(() => { delete process.env.PREVIEW_USER; delete process.env.PREVIEW_PASSWORD; });
+
+  it("lets the payer's address check through without the password, like /pay/<publicId>", () => {
+    expect(middleware(req("/pay/abc123")).status).not.toBe(401);
+    expect(middleware(req("/api/pay/abc123/check", "POST")).status).not.toBe(401);
+  });
+
+  it("still asks for the password on the rest of the app", () => {
+    expect(middleware(req("/")).status).toBe(401);
+    expect(middleware(req("/requests")).status).toBe(401);
+    expect(middleware(req("/api/requests", "POST")).status).toBe(401);
+  });
+});
